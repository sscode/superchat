<!-- Chats are immediate; projects stay optional; the conversation remains the dominant plane. -->
<stack>
  <column background="background">
    <row height="{header_height}" padding="12" gap="12" cross="center" background="surface" label="Superchat toolbar">
      <text><span scale="1.15" weight="bold">{brandLabel}</span></text>
      <spacer grow="1" />
      <if test="{hasThreadCost}">
        <badge size="sm" variant="outline">{threadCostLabel}</badge>
      </if>
      <column gap="2" cross="end">
        <row gap="8" cross="center">
          <text size="sm" foreground="text_muted">Next response</text>
          <select size="sm" width="224" on-press="toggle_model_picker" label="Model for the next response">{selectedModelLabel}</select>
        </row>
        <text size="sm" foreground="text_muted">{headerConnectionLabel}</text>
      </column>
    </row>
    <row grow="1">
      <column width="268" background="surface">
        <row padding="16" gap="6" cross="center">
          <text size="sm" foreground="text_muted" grow="1"><span weight="bold">CHATS</span></text>
          <button size="sm" variant="ghost" icon="archive" on-press="open_archive" label="Open archive"></button>
          <button size="sm" variant="ghost" icon="plus" on-press="new_thread" disabled="{cannotAddThread}" label="New top-level chat"></button>
        </row>
        <scroll grow="1" label="Chats and projects">
          <column padding="12" gap="6">
            <for each="topLevelThreadRows" key="id" as="t">
              <list-item on-press="select_thread:{t.id}" selected="{t.selected}" label="{t.title}">{t.title}</list-item>
            </for>
            <separator />
            <row padding="6" gap="6" cross="center">
              <text size="sm" foreground="text_muted" grow="1"><span weight="bold">PROJECTS</span></text>
              <button size="sm" variant="ghost" icon="edit" on-press="open_rename_project" disabled="{cannotManageProject}" label="Rename selected project"></button>
              <button size="sm" variant="ghost" icon="archive" on-press="archive_project" disabled="{cannotManageProject}" label="Archive selected project"></button>
              <button size="sm" variant="ghost" icon="plus" on-press="new_project_thread" disabled="{cannotManageProject}" label="New chat in selected project"></button>
              <button size="sm" variant="ghost" icon="folder" on-press="new_project" disabled="{cannotAddProject}" label="New project"></button>
            </row>
            <for each="projectSidebarRows" key="key" as="r">
              <if test="{r.is_project}">
                <if test="{r.selected}">
                  <button size="sm" grow="1" variant="secondary" icon="folder-open" on-press="select_sidebar_row:{r.key}" label="Selected project {r.title}">{r.title}</button>
                </if>
                <else>
                  <button size="sm" grow="1" variant="ghost" icon="folder" on-press="select_sidebar_row:{r.key}" label="Project {r.title}">{r.title}</button>
                </else>
              </if>
              <else>
                <list-item on-press="select_sidebar_row:{r.key}" selected="{r.selected}" label="Chat {r.title}">{r.prefix} {r.title}</list-item>
              </else>
            </for>
          </column>
        </scroll>
        <separator />
        <column padding="12" gap="8" background="background">
          <button size="sm" variant="outline" icon="terminal" on-press="open_shortcuts" label="Open keyboard shortcuts, Command comma">Keyboard shortcuts · Cmd + ,</button>
          <button size="sm" variant="ghost" icon="settings" on-press="open_settings">Settings</button>
        </column>
      </column>
      <separator />

      <column grow="1">
        <row height="48" padding="8" gap="4" cross="center" background="background">
          <text grow="1"><span scale="1.08" weight="bold">{activeThreadTitle}</span></text>
          <button size="sm" variant="ghost" icon="edit" on-press="open_rename_thread" label="Rename chat"></button>
          <button size="sm" variant="ghost" icon="archive" on-press="archive_thread" label="Archive chat"></button>
        </row>
        <separator />
        <scroll grow="1" label="Conversation">
          <column padding="28" gap="20">
            <if test="{canLoadOlder}">
              <button size="sm" variant="outline" on-press="load_older">Load earlier messages</button>
            </if>
            <for each="messageRows" key="id" as="m">
              <if test="{m.isUser}">
                <row main="end">
                  <column gap="4" cross="end" label="You said">
                    <text size="sm" foreground="text_muted">You</text>
                    <text wrap="true">{m.content}  {m.attachmentSummary}</text>
                    <button size="sm" variant="ghost" foreground="text_muted" on-press="edit_message:{m.id}">Edit</button>
                  </column>
                </row>
              </if>
              <else>
                <row main="start">
                  <column gap="6">
                    <bubble variant="ghost" label="Assistant said">
                      <markdown source="{m.content}" />
                    </bubble>
                    <row gap="6">
                      <button size="sm" variant="ghost" foreground="text_muted" icon="copy" on-press="copy_message:{m.id}" label="Copy full response">Copy</button>
                      <button size="sm" variant="ghost" foreground="text_muted" on-press="retry_message:{m.id}">Retry</button>
                      <button size="sm" variant="ghost" foreground="text_muted" icon="git-branch" on-press="open_fork:{m.id}" label="Fork from this response">Fork</button>
                    </row>
                  </column>
                </row>
              </else>
            </for>
            <if test="{sending}">
              <row gap="8" cross="center" label="Assistant is thinking">
                <spinner size="sm" />
                <text size="sm" foreground="text_muted">Thinking…</text>
              </row>
            </if>
          </column>
        </scroll>
        <separator />
        <column padding="16" gap="10" background="surface">
          <for each="draftAttachmentRows" key="index" as="a">
            <button size="sm" variant="outline" icon="x" on-press="remove_attachment:{a.index}" label="Remove {a.name}">{a.detail} · {a.name}</button>
          </for>
          <textarea key="{composerKey}" text="{draft}" on-input="draft_edit" on-submit="composer_newline" autofocus="true" height="96" placeholder="Message any model, or drop images and files…" label="Message" />
          <row cross="center" gap="8">
            <button size="sm" variant="ghost" icon="plus" on-press="open_file_picker" label="Attach images or files, Command U">Attach · Cmd + U</button>
            <spacer grow="1" />
            <if test="{missingKey}">
              <button size="sm" variant="outline" icon="settings" on-press="open_settings">Add API key</button>
            </if>
            <button size="sm" variant="ghost" on-press="stop" disabled="{cannotStop}">Stop</button>
            <button variant="primary" on-press="send" disabled="{cannotSend}">Send</button>
          </row>
        </column>
        <if test="{statusVisible}">
          <status-bar>{statusLine}</status-bar>
        </if>
      </column>
    </row>
  </column>

  <if test="{model_picker_open}">
    <panel background="scrim" on-press="close_overlay" label="Command palette backdrop">
      <column main="center" cross="center">
        <dialog width="720" height="500" label="Command palette">
          <column padding="24" gap="12">
            <if test="{search_open}">
              <text-field text="{searchText}" on-input="search_edit" placeholder="Search every chat…" autofocus="true" />
              <scroll grow="1" label="Search results">
                <for each="searchRows" key="index" as="r">
                  <button on-press="select_search_result:{r.index}">{r.title} · {r.snippet}</button>
                </for>
              </scroll>
            </if>
            <else>
            <if test="{move_open}">
              <text size="heading">Move this chat</text>
              <text size="sm" foreground="text_muted">Choose where this conversation should live.</text>
              <scroll grow="1" label="Project destinations">
                <for each="moveProjectRows" as="p">
                  <list-item on-press="move_thread_to:{p.id}" selected="{p.selected}">{p.name}</list-item>
                </for>
              </scroll>
            </if>
            <else>
            <text size="heading">Go anywhere</text>
            <text-field text="{modelSearch}" on-input="model_search_edit" placeholder="Search chats, projects, or models…" autofocus="true" label="Universal search" />
            <scroll grow="1" label="Commands, chats, projects, and models">
              <column gap="10">
                <text size="sm" foreground="text_muted"><span weight="bold">WORKSPACE</span></text>
                <for each="paletteWorkspaceRows" as="w">
                  <button on-press="select_palette_workspace:{w.key}">{w.title} · {w.detail}</button>
                </for>
                <text size="sm" foreground="text_muted"><span weight="bold">ACTIONS</span></text>
                <grid columns="2" gap="6">
                  <for each="paletteActionRows" as="a">
                    <button size="sm" variant="ghost" on-press="palette_action:{a.id}">{a.label} · {a.shortcut}</button>
                  </for>
                </grid>
                <text size="sm" foreground="text_muted"><span weight="bold">MODELS</span></text>
                <grid columns="3" gap="6">
                  <for each="quickModels" as="q">
                    <button size="sm" variant="outline" on-press="select_quick_model:{q.number}" label="{q.slug}">{q.number} · {q.label}</button>
                  </for>
                  <button size="sm" variant="outline" on-press="select_codex_subscription">Codex · ChatGPT</button>
                  <button size="sm" variant="outline" on-press="select_claude_subscription" disabled="{claudeSubscriptionDisabled}">Claude · Experimental</button>
                </grid>
                <for each="catalogRows" key="index" as="m">
                  <row>
                    <button grow="1" on-press="select_catalog_model:{m.index}">{m.label} · {m.slug}</button>
                    <button on-press="toggle_model_favorite:{m.index}">{m.favorite_label}</button>
                  </row>
                </for>
              </column>
            </scroll>
            <row gap="8" main="end">
              <button size="sm" variant="outline" on-press="select_auto_model">OpenRouter Auto</button>
              <button size="sm" variant="ghost" on-press="select_custom_model">Enter model ID manually</button>
            </row>
            </else>
            </else>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{settings_open}">
    <panel background="scrim" on-press="close_settings" label="Settings backdrop">
      <column main="center" cross="center">
        <dialog width="680" height="520" label="Settings">
          <column padding="24" gap="12">
            <text size="heading">Settings</text>
            <scroll grow="1" label="Settings">
              <column gap="12">
                <text><span weight="bold">Model connections</span></text>
                <text size="sm" foreground="text_muted" wrap="true">Connect a subscription or use OpenRouter for access to its full model catalog.</text>
                <button size="sm" variant="outline" on-press="connect_codex" disabled="{codexConnectionBusy}">{codexConnectionButtonText}</button>
                <button size="sm" variant="outline" on-press="connect_claude" disabled="{claudeSubscriptionDisabled}">{claudeConnectionButtonText}</button>
                <text-field text="{apiKeyField}" on-input="api_key_edit" on-submit="save_settings" placeholder="{apiKeyPlaceholder}" label="OpenRouter API key" />
                <text-field text="{modelName}" on-input="model_edit" on-submit="save_settings" placeholder="provider/model" label="Custom OpenRouter model" />
                <checkbox checked="{notifications_enabled}" on-toggle="toggle_notifications" text="Notify when a background response finishes" />
                <separator />
                <text><span weight="bold">MCP integrations</span></text>
                <text size="sm" foreground="text_muted" wrap="true">Local stdio servers run on this Mac. Choose a discovered tool to place a reviewable /mcp command in the composer.</text>
                <for each="mcpServerRows" as="s">
                  <row padding="4" gap="8" cross="center">
                    <column grow="1" gap="2">
                      <text>{s.name}</text>
                      <text size="sm" foreground="text_muted">{s.detail}</text>
                    </column>
                    <button size="sm" variant="ghost" on-press="toggle_mcp_server:{s.id}" disabled="{mcpBusy}">{s.toggle_label}</button>
                    <button size="sm" variant="ghost" icon="refresh-cw" on-press="refresh_mcp_server:{s.id}" disabled="{mcpBusy}" label="Refresh {s.name}"></button>
                    <button size="sm" variant="ghost" icon="trash" on-press="remove_mcp_server:{s.id}" disabled="{mcpBusy}" label="Remove {s.name}"></button>
                  </row>
                </for>
                <row gap="8" cross="end">
                  <text-field size="sm" grow="1" text="{mcpServerName}" on-input="mcp_server_name_edit" placeholder="Filesystem" label="Server name" />
                  <text-field size="sm" grow="3" text="{mcpServerCommand}" on-input="mcp_server_command_edit" on-submit="add_mcp_server" placeholder="npx -y @modelcontextprotocol/server-filesystem /path" label="Local stdio command" />
                  <button size="sm" variant="outline" on-press="add_mcp_server" disabled="{cannotAddMcpServer}">Add server</button>
                </row>
                <text size="sm" foreground="text_muted"><span weight="bold">AVAILABLE TOOLS</span></text>
                <for each="mcpToolRows" as="t">
                  <button size="sm" variant="ghost" icon="terminal" on-press="select_mcp_tool:{t.index}" disabled="{mcpBusy}">{t.title} · {t.detail}</button>
                </for>
                <separator />
                <text><span weight="bold">Prompt snippets</span></text>
                <text size="sm" foreground="text_muted">Save repeatable instructions and insert them from the command palette.</text>
                <for each="snippetRows" as="s">
                  <row gap="6">
                    <button size="sm" grow="1" variant="ghost" on-press="use_snippet:{s.id}">{s.command} · {s.preview}</button>
                    <button size="sm" variant="ghost" icon="trash" on-press="delete_snippet:{s.id}" label="Delete {s.command}"></button>
                  </row>
                </for>
                <row gap="8">
                  <text-field size="sm" grow="1" text="{snippetName}" on-input="snippet_name_edit" placeholder="name" label="Shortcut name" />
                  <text-field size="sm" grow="2" text="{snippetBody}" on-input="snippet_body_edit" on-submit="save_snippet" placeholder="Reusable prompt…" label="Prompt" />
                  <button size="sm" variant="outline" on-press="save_snippet" disabled="{cannotSaveSnippet}">Save</button>
                </row>
                <separator />
                <text><span weight="bold">Updates</span></text>
                <button size="sm" variant="outline" icon="refresh-cw" on-press="open_update" disabled="{updateButtonDisabled}">{updateStatus} · {updateButtonText}</button>
              </column>
            </scroll>
            <row gap="8" main="end">
              <button size="sm" variant="ghost" on-press="remove_api_key" disabled="{missingKey}">Remove key</button><spacer grow="1" />
              <button size="sm" variant="ghost" on-press="close_settings">Close</button>
              <button size="sm" variant="primary" on-press="save_settings" disabled="{cannotSaveSettings}">Save</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{shortcuts_open}">
    <panel background="scrim" on-press="close_shortcuts" label="Keyboard shortcuts backdrop">
      <column main="center" cross="center">
        <dialog width="680" height="520" label="Keyboard shortcuts">
          <column padding="24" gap="12">
            <row gap="12" cross="center">
              <column grow="1" gap="4">
                <text size="heading">Keyboard shortcuts</text>
                <text size="sm" foreground="text_muted">Move through Superchat without leaving the keyboard.</text>
              </column>
              <badge size="sm" variant="outline">Cmd + ,</badge>
            </row>
            <separator />
            <scroll grow="1" label="All keyboard shortcuts">
              <column gap="8">
                <for each="shortcutHints" as="h">
                  <row padding="6" gap="16" cross="center">
                    <text grow="1">{h.action}</text>
                    <badge size="sm" variant="secondary">{h.keys}</badge>
                  </row>
                </for>
              </column>
            </scroll>
            <row main="end">
              <button size="sm" variant="primary" on-press="close_shortcuts">Done</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{fork_open}">
    <panel background="scrim" on-press="close_fork" label="Fork conversation backdrop">
      <column main="center" cross="center">
        <dialog width="660" height="460" label="Fork conversation">
          <column padding="24" gap="14">
            <text size="heading">Fork this response</text>
            <text size="sm" foreground="text_muted" wrap="true">Create one new conversation per selected model, carrying the history up to this response.</text>
            <textarea text="{forkSeed}" on-input="fork_seed_edit" on-submit="create_forks" height="92" placeholder="Optional follow-up for every selected model…" label="Fork follow-up message" />
            <text size="sm" foreground="text_muted"><span weight="bold">MODELS</span></text>
            <grid columns="3" gap="8">
              <for each="forkModelRows" as="m">
                <checkbox checked="{m.selected}" on-toggle="toggle_fork_model:{m.choice}" text="{m.label}" label="{m.label}" />
              </for>
            </grid>
            <row gap="8" main="end">
              <button size="sm" variant="ghost" on-press="close_fork">Cancel</button>
              <button size="sm" variant="primary" on-press="create_forks" disabled="{cannotCreateForks}">{forkCountLabel}</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{rename_open}">
    <panel background="scrim" on-press="close_rename" label="Rename backdrop">
      <column main="center" cross="center">
        <dialog width="460" height="220" label="Rename">
          <column padding="24" gap="12">
            <text size="heading">{renameHeading}</text>
            <text size="sm" foreground="text_muted">The new name updates everywhere immediately.</text>
            <text-field text="{renameValue}" on-input="rename_edit" on-submit="save_rename" autofocus="true" label="New name" />
            <spacer grow="1" />
            <row gap="8" main="end">
              <button size="sm" variant="ghost" on-press="close_rename">Cancel</button>
              <button size="sm" variant="primary" on-press="save_rename" disabled="{cannotSaveRename}">Rename</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{archive_open}">
    <panel background="scrim" on-press="close_archive" label="Archive backdrop">
      <column main="center" cross="center">
        <dialog width="720" height="500" label="Archive">
          <column padding="24" gap="12">
            <text size="heading">Archive</text>
            <text size="sm" foreground="text_muted">Restore an item, or permanently delete it before its 30-day expiry.</text>
            <scroll grow="1" label="Archived items">
              <column gap="10">
                <for each="archivedProjectRows" as="p">
                  <row padding="4" gap="8" cross="center">
                    <text grow="1">{p.name} · {p.expiry}</text>
                    <button size="sm" variant="outline" on-press="restore_project:{p.id}">Restore</button>
                    <button size="sm" variant="ghost" icon="trash" on-press="delete_project:{p.id}">Delete forever</button>
                  </row>
                </for>
                <for each="archivedThreadRows" as="t">
                  <row padding="4" gap="8" cross="center">
                    <text grow="1">{t.title} · {t.project_name} · {t.expiry}</text>
                    <button size="sm" variant="outline" on-press="restore_thread:{t.id}">Restore</button>
                    <button size="sm" variant="ghost" icon="trash" on-press="delete_thread:{t.id}">Delete forever</button>
                  </row>
                </for>
              </column>
            </scroll>
            <if test="{delete_confirm_open}">
              <row gap="8" cross="center">
                <text grow="1" wrap="true">{deleteTargetLabel}</text>
                <button size="sm" variant="ghost" on-press="cancel_delete">Cancel</button>
                <button size="sm" variant="destructive" on-press="confirm_delete">Delete forever</button>
              </row>
            </if>
            <row main="end"><button size="sm" variant="primary" on-press="close_archive">Done</button></row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{onboarding_open}">
    <panel background="scrim" label="Welcome to Superchat">
      <column main="center" cross="center">
        <dialog width="660" height="500" label="Connect a model provider">
          <column padding="24" gap="10">
            <text size="heading">Welcome to Superchat</text>
            <text foreground="text_muted" wrap="true">Use Codex with your ChatGPT account, or connect OpenRouter. Provider sign-in stays in the official app or CLI.</text>
            <text size="sm" foreground="text_muted"><span weight="bold">SUBSCRIPTIONS</span></text>
            <button size="lg" variant="outline" on-press="connect_codex" disabled="{codexConnectionBusy}">{codexConnectionButtonText}</button>
            <button size="lg" variant="outline" on-press="connect_claude" disabled="{claudeSubscriptionDisabled}">{claudeConnectionButtonText}</button>
            <text size="sm" foreground="text_muted"><span weight="bold">OR USE AN API KEY</span></text>
            <text-field text="{apiKeyField}" on-input="api_key_edit" on-submit="finish_onboarding" placeholder="sk-or-v1-…" autofocus="true" label="OpenRouter API key" />
            <button variant="primary" on-press="finish_onboarding" disabled="{cannotFinishOnboarding}">Connect OpenRouter</button>
            <text size="sm" foreground="text_muted" wrap="true">{statusLine}</text>
            <button size="sm" variant="ghost" on-press="skip_onboarding">Set up later</button>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{toastVisible}">
    <column main="end" cross="center" padding="32">
      <badge variant="secondary">{toastText}</badge>
    </column>
  </if>
</stack>
