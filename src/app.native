<!-- Chats are immediate; projects stay optional; the conversation remains the dominant plane. -->
<stack>
  <column background="background">
    <row height="{header_height}" padding="12" gap="10" cross="center" background="surface" label="Superchat toolbar">
      <text size="heading">{brandLabel}</text>
      <spacer grow="1" />
      <select size="sm" width="210" on-press="toggle_model_picker" label="Model selector">{selectedModelLabel}</select>
      <button size="sm" variant="ghost" icon="trash" on-press="clear" disabled="{cannotClear}" label="{clearButtonLabel}"></button>
    </row>
    <row grow="1">
      <column width="226" background="surface">
        <row padding="10" gap="8" cross="center">
          <text foreground="text_muted" grow="1">Chats</text>
          <button size="sm" variant="ghost" icon="archive" on-press="open_archive" label="Open archive"></button>
          <button size="sm" variant="ghost" icon="plus" on-press="new_thread" disabled="{cannotAddThread}" label="New top-level chat"></button>
        </row>
        <scroll grow="1" label="Chats and projects">
          <column padding="6" gap="2">
            <for each="topLevelThreadRows" key="id" as="t">
              <list-item on-press="select_thread:{t.id}" selected="{t.selected}" label="{t.title}">{t.title}</list-item>
            </for>
            <separator />
            <row padding="4" gap="8" cross="center">
              <text foreground="text_muted" grow="1">Projects</text>
              <button size="sm" variant="ghost" icon="edit" on-press="open_rename_project" disabled="{cannotManageProject}" label="Rename selected project"></button>
              <button size="sm" variant="ghost" icon="archive" on-press="archive_project" disabled="{cannotManageProject}" label="Archive selected project"></button>
              <button size="sm" variant="ghost" icon="plus" on-press="new_project_thread" disabled="{cannotManageProject}" label="New chat in selected project"></button>
              <button size="sm" variant="ghost" icon="plus" on-press="new_project" disabled="{cannotAddProject}" label="New project"></button>
            </row>
            <for each="projectSidebarRows" key="key" as="r">
              <list-item on-press="select_sidebar_row:{r.key}" selected="{r.selected}" label="{r.title}">{r.prefix} {r.title}</list-item>
            </for>
          </column>
        </scroll>
        <button size="sm" variant="ghost" on-press="open_settings" label="View keyboard shortcuts, Command comma">Keyboard shortcuts · Cmd + ,</button>
      </column>
      <separator />

      <column grow="1">
        <row height="42" padding="12" cross="center" background="background">
          <text grow="1">{activeThreadTitle}</text>
          <button size="sm" variant="ghost" icon="edit" on-press="open_rename_thread" label="Rename chat"></button>
          <button size="sm" variant="ghost" icon="archive" on-press="archive_thread" label="Archive chat"></button>
        </row>
        <separator />
        <scroll grow="1" label="Conversation">
          <column padding="24" gap="14">
            <if test="{canLoadOlder}">
              <button on-press="load_older">Load earlier messages</button>
            </if>
            <for each="messageRows" key="id" as="m">
              <if test="{m.isUser}">
                <row main="end">
                  <button variant="ghost" on-press="edit_message:{m.id}">Edit</button>
                  <bubble variant="primary" label="You said"><text wrap="true">{m.content}  {m.attachmentSummary}</text></bubble>
                </row>
              </if>
              <else>
                <row main="start">
                  <column gap="4">
                    <bubble variant="ghost" label="Assistant said">
                      <markdown source="{m.content}" />
                    </bubble>
                    <row gap="4">
                      <button size="sm" variant="ghost" icon="copy" on-press="copy_message:{m.id}" label="Copy full response">{m.responseActionLabel}</button>
                      <button variant="ghost" on-press="retry_message:{m.id}">Retry</button>
                      <button size="sm" variant="ghost" icon="git-branch" on-press="open_fork:{m.id}" label="Fork from this response">Fork</button>
                    </row>
                  </column>
                </row>
              </else>
            </for>
            <if test="{sending}">
              <badge variant="outline">Thinking…</badge>
            </if>
          </column>
        </scroll>
        <separator />
        <column padding="14" gap="8" background="surface">
          <for each="draftAttachmentRows" key="index" as="a">
            <button size="sm" variant="outline" icon="x" on-press="remove_attachment:{a.index}" label="Remove {a.name}">{a.detail} · {a.name}</button>
          </for>
          <textarea key="{composerKey}" text="{draft}" on-input="draft_edit" on-submit="composer_newline" autofocus="true" height="92" placeholder="Message any model, or drop images and files…" label="Message" />
          <row cross="center" gap="8">
            <button size="sm" variant="ghost" icon="plus" on-press="open_file_picker" label="Attach images or files, Command U">Attach · Cmd + U</button>
            <spacer grow="1" />
            <if test="{missingKey}">
              <button size="sm" variant="outline" icon="settings" on-press="open_settings">Add API key</button>
            </if>
            <button variant="ghost" on-press="stop" disabled="{cannotStop}">Stop</button>
            <button variant="primary" on-press="send" disabled="{cannotSend}">Send</button>
          </row>
        </column>
        <status-bar>{statusLine}</status-bar>
      </column>
    </row>
  </column>

  <if test="{model_picker_open}">
    <panel background="scrim" on-press="close_overlay" label="Command palette backdrop">
      <column main="center" cross="center">
        <dialog width="680" height="440" label="Command palette">
          <column padding="20" gap="10">
            <if test="{search_open}">
              <text-field text="{searchText}" on-input="search_edit" placeholder="Search every chat…" autofocus="true" />
              <scroll grow="1" label="Search results">
                <for each="searchRows" key="index" as="r">
                  <button on-press="select_search_result:{r.index}">{r.title} · {r.snippet}</button>
                </for>
              </scroll>
            </if>
            <else>
            <if test="{move_open}">
              <text size="heading">Move this chat</text>
              <scroll grow="1" label="Project destinations">
                <for each="moveProjectRows" as="p">
                  <list-item on-press="move_thread_to:{p.id}" selected="{p.selected}">{p.name}</list-item>
                </for>
              </scroll>
            </if>
            <else>
            <text size="heading">Go anywhere</text>
            <text-field text="{modelSearch}" on-input="model_search_edit" placeholder="Search chats, projects, or models…" autofocus="true" label="Universal search" />
            <scroll grow="1" label="Commands, chats, projects, and models">
              <column gap="8">
                <for each="paletteWorkspaceRows" as="w">
                  <button on-press="select_palette_workspace:{w.key}">{w.title} · {w.detail}</button>
                </for>
                <grid columns="2" gap="4">
                  <for each="paletteActionRows" as="a">
                    <button variant="ghost" on-press="palette_action:{a.id}">{a.label} · {a.shortcut}</button>
                  </for>
                </grid>
                <grid columns="3" gap="6">
                  <for each="quickModels" as="q">
                    <button variant="outline" on-press="select_quick_model:{q.number}" label="{q.slug}">{q.number} · {q.label}</button>
                  </for>
                  <button variant="outline" on-press="select_codex_subscription">Codex · ChatGPT</button>
                  <button variant="outline" on-press="select_claude_subscription" disabled="{claudeSubscriptionDisabled}">Claude · Experimental</button>
                </grid>
                <for each="catalogRows" key="index" as="m">
                  <row>
                    <button grow="1" on-press="select_catalog_model:{m.index}">{m.label} · {m.slug}</button>
                    <button on-press="toggle_model_favorite:{m.index}">{m.favorite_label}</button>
                  </row>
                </for>
              </column>
            </scroll>
            <row gap="8" main="end">
              <button variant="outline" on-press="select_auto_model">OpenRouter Auto</button>
              <button variant="ghost" on-press="select_custom_model">Enter model ID manually</button>
            </row>
            </else>
            </else>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{settings_open}">
    <panel background="scrim" on-press="close_settings" label="Settings backdrop">
      <column main="center" cross="center">
        <dialog width="600" height="480" label="Settings">
          <column padding="20" gap="10">
            <text size="heading">Settings</text>
            <scroll grow="1" label="Settings and keyboard shortcuts">
              <column gap="8">
                <button variant="outline" on-press="connect_codex" disabled="{codexConnectionBusy}">{codexConnectionButtonText}</button>
                <button variant="outline" on-press="connect_claude" disabled="{claudeSubscriptionDisabled}">{claudeConnectionButtonText}</button>
                <text-field text="{apiKeyField}" on-input="api_key_edit" on-submit="save_settings" placeholder="{apiKeyPlaceholder}" label="OpenRouter API key" />
                <text-field text="{modelName}" on-input="model_edit" on-submit="save_settings" placeholder="provider/model" label="Custom OpenRouter model" />
                <checkbox checked="{notifications_enabled}" on-toggle="toggle_notifications" text="Notify when a background response finishes" />
                <text size="heading">Prompt snippets</text>
                <for each="snippetRows" as="s">
                  <row>
                    <button grow="1" on-press="use_snippet:{s.id}">{s.command} · {s.preview}</button>
                    <button on-press="delete_snippet:{s.id}">Delete</button>
                  </row>
                </for>
                <row>
                  <text-field grow="1" text="{snippetName}" on-input="snippet_name_edit" placeholder="name" />
                  <text-field grow="2" text="{snippetBody}" on-input="snippet_body_edit" on-submit="save_snippet" placeholder="Reusable prompt…" />
                  <button on-press="save_snippet" disabled="{cannotSaveSnippet}">Save</button>
                </row>
                <button variant="outline" on-press="open_update" disabled="{updateButtonDisabled}">{updateStatus} · {updateButtonText}</button>
                <for each="shortcutHints" as="h">
                  <text>{h.action} · {h.keys}</text>
                </for>
              </column>
            </scroll>
            <row gap="8" main="end">
              <button variant="ghost" on-press="remove_api_key" disabled="{missingKey}">Remove key</button><spacer grow="1" />
              <button size="sm" variant="ghost" on-press="close_settings">Cancel</button>
              <button size="sm" variant="primary" on-press="save_settings" disabled="{cannotSaveSettings}">Save</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{fork_open}">
    <panel background="scrim" on-press="close_fork" label="Fork conversation backdrop">
      <column main="center" cross="center">
        <dialog width="620" height="430" label="Fork conversation">
          <column padding="24" gap="10">
            <text size="heading">Fork this response</text>
            <textarea text="{forkSeed}" on-input="fork_seed_edit" on-submit="create_forks" height="84" placeholder="Optional follow-up for every selected model…" label="Fork follow-up message" />
            <grid columns="3" gap="8">
              <for each="forkModelRows" as="m">
                <checkbox checked="{m.selected}" on-toggle="toggle_fork_model:{m.choice}" text="{m.label}" label="{m.label}" />
              </for>
            </grid>
            <row gap="8" main="end">
              <button size="sm" variant="ghost" on-press="close_fork">Cancel</button>
              <button size="sm" variant="primary" on-press="create_forks" disabled="{cannotCreateForks}">{forkCountLabel}</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{rename_open}">
    <panel background="scrim" on-press="close_rename" label="Rename backdrop">
      <column main="center" cross="center">
        <dialog width="440" height="210" label="Rename">
          <column padding="24" gap="12">
            <text size="heading">{renameHeading}</text>
            <text-field text="{renameValue}" on-input="rename_edit" on-submit="save_rename" autofocus="true" label="New name" />
            <button variant="primary" on-press="save_rename" disabled="{cannotSaveRename}">Rename</button>
            <button variant="ghost" on-press="close_rename">Cancel</button>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{archive_open}">
    <panel background="scrim" on-press="close_archive" label="Archive backdrop">
      <column main="center" cross="center">
        <dialog width="680" height="440" label="Archive">
          <column padding="24" gap="10">
            <text size="heading">Archive</text>
            <scroll grow="1" label="Archived items">
              <column gap="8">
                <for each="archivedProjectRows" as="p">
                  <row gap="8" cross="center">
                    <text grow="1">{p.name} · {p.expiry}</text>
                    <button variant="outline" on-press="restore_project:{p.id}">Restore</button>
                    <button variant="ghost" on-press="delete_project:{p.id}">Delete forever</button>
                  </row>
                </for>
                <for each="archivedThreadRows" as="t">
                  <row gap="8" cross="center">
                    <text grow="1">{t.title} · {t.project_name} · {t.expiry}</text>
                    <button variant="outline" on-press="restore_thread:{t.id}">Restore</button>
                    <button variant="ghost" on-press="delete_thread:{t.id}">Delete forever</button>
                  </row>
                </for>
              </column>
            </scroll>
            <if test="{delete_confirm_open}">
              <row gap="8" cross="center">
                <text grow="1" wrap="true">{deleteTargetLabel}</text>
                <button variant="ghost" on-press="cancel_delete">Cancel</button>
                <button variant="primary" on-press="confirm_delete">Delete forever</button>
              </row>
            </if>
            <button variant="primary" on-press="close_archive">Done</button>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{onboarding_open}">
    <panel background="scrim" label="Welcome to Superchat">
      <column main="center" cross="center">
        <dialog width="620" height="430" label="Connect a model provider">
          <column padding="24" gap="10">
            <text size="heading">Welcome to Superchat</text>
            <text foreground="text_muted" wrap="true">Use Codex with your ChatGPT account, or connect OpenRouter. Provider sign-in stays in the official app or CLI.</text>
            <button variant="outline" on-press="connect_codex" disabled="{codexConnectionBusy}">{codexConnectionButtonText}</button>
            <button variant="outline" on-press="connect_claude" disabled="{claudeSubscriptionDisabled}">{claudeConnectionButtonText}</button>
            <text foreground="text_muted" wrap="true">{statusLine}</text>
            <text-field text="{apiKeyField}" on-input="api_key_edit" on-submit="finish_onboarding" placeholder="sk-or-v1-…" autofocus="true" label="OpenRouter API key" />
            <button variant="primary" on-press="finish_onboarding" disabled="{cannotFinishOnboarding}">Connect OpenRouter</button>
            <button size="sm" variant="ghost" on-press="skip_onboarding">Set up later</button>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{toastVisible}">
    <column main="end" cross="center" padding="24">
      <badge variant="secondary">{toastText}</badge>
    </column>
  </if>
</stack>
