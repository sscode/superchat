<!-- A calm local workspace: navigation supports the work, the conversation is the artifact. -->
<stack background="background">
  <row grow="1">
    <panel width="260" background="surface_subtle" border-color="surface_subtle" radius="sm">
    <column grow="1">
      <row height="{sidebar_header_height}" padding="12" cross="center" window-drag="true" label="Window controls">
        <spacer width="{header_inset_left}" />
        <spacer grow="1" />
      </row>
      <row height="56" padding="16" gap="8" cross="center" label="Superchat navigation">
        <text grow="1"><span scale="1.16" weight="bold">Superchat</span></text>
        <if test="{dev_mode}">
          <badge size="sm" variant="outline">Dev</badge>
        </if>
        <if test="{updateAvailable}">
          <button size="sm" variant="ghost" icon="download" on-press="open_update" label="A Superchat update is available"></button>
        </if>
        <button size="sm" variant="ghost" icon="search" on-press="open_search" label="Search every chat, Command F"></button>
      </row>

      <column padding="12" gap="2" label="Pinned sidebar actions">
        <list-item size="lg" icon="edit" on-press="new_thread" disabled="{cannotAddThread}" label="New chat in the current location">New chat</list-item>
        <list-item icon="search" on-press="open_search">Search</list-item>
        <list-item icon="archive" on-press="open_archive">Archive</list-item>
      </column>

      <separator label="Workspace list boundary" />

      <scroll grow="1" label="Chats and projects">
        <column padding="12" gap="2">
          <row padding="8" gap="4" cross="center">
            <text size="sm" foreground="text_muted" grow="1"><span weight="medium">Chats</span></text>
            <button size="sm" variant="ghost" icon="plus" on-press="new_top_level_thread" disabled="{cannotAddThread}" label="New top-level chat"></button>
          </row>
          <for each="topLevelThreadRows" key="id" as="t">
            <list-item gap="8" cross="center" on-press="select_thread:{t.id}" selected="{t.selected}" label="{t.title}">
              <spacer width="24" />
              <text grow="1">{t.title}</text>
              <if test="{t.sending}">
                <spinner size="sm" />
              </if>
              <else>
                <if test="{t.unread}">
                  <icon name="circle-dot" width="12" height="12" foreground="info" />
                </if>
              </else>
            </list-item>
          </for>

          <row padding="8" gap="4" cross="center">
            <text size="sm" foreground="text_muted" grow="1"><span weight="medium">Projects</span></text>
            <stack width="28" height="28">
              <button size="sm" variant="ghost" icon="ellipsis" on-press="toggle_project_menu" disabled="{cannotManageProject}" label="Selected project actions"></button>
              <if test="{project_menu_open}">
                <dropdown-menu anchor="below" anchor-alignment="end" anchor-offset="6" width="196" height="132" padding="4" gap="2" on-dismiss="close_project_menu" label="Project actions">
                  <menu-item size="sm" icon="plus" on-press="new_project_thread">New chat in project</menu-item>
                  <menu-item size="sm" icon="folder" on-press="open_project_context">Instructions &amp; knowledge</menu-item>
                  <menu-item size="sm" icon="edit" on-press="open_rename_project">Rename project</menu-item>
                  <separator />
                  <menu-item size="sm" icon="archive" on-press="archive_project">Archive project</menu-item>
                </dropdown-menu>
              </if>
            </stack>
            <button size="sm" variant="ghost" icon="plus" on-press="new_project" disabled="{cannotAddProject}" label="New project"></button>
          </row>
          <for each="projectSidebarRows" key="key" as="r">
            <if test="{r.is_project}">
              <list-item size="lg" icon="folder" on-press="select_sidebar_row:{r.key}" selected="{r.selected}" label="{r.title}">{r.title}</list-item>
            </if>
            <else>
              <list-item gap="8" cross="center" on-press="select_sidebar_row:{r.key}" selected="{r.selected}" label="{r.title}">
                <spacer width="24" />
                <text grow="1">{r.title}</text>
                <if test="{r.sending}">
                  <spinner size="sm" />
                </if>
                <else>
                  <if test="{r.unread}">
                    <icon name="circle-dot" width="12" height="12" foreground="info" />
                  </if>
                </else>
              </list-item>
            </else>
          </for>
        </column>
      </scroll>

      <separator />
      <row padding="12" gap="8" cross="center" background="surface">
        <avatar size="sm">SC</avatar>
        <column gap="2" grow="1">
          <text><span weight="medium">On this Mac</span></text>
          <text size="sm" foreground="text_muted">Private workspace</text>
        </column>
        <button size="sm" variant="ghost" icon="terminal" on-press="open_shortcuts" label="Keyboard shortcuts, Command comma"></button>
        <button size="sm" variant="ghost" icon="settings" on-press="open_settings" label="Settings"></button>
      </row>
    </column>
    </panel>

    <separator />

    <column grow="1" background="background">
      <row height="{header_height}" padding="16" gap="10" cross="center" window-drag="true">
        <icon name="folder" width="18" height="18" foreground="text_muted" />
        <text grow="1"><span scale="1.08" weight="bold">{activeThreadTitle}</span></text>
        <stack width="28" height="28">
          <button size="sm" variant="ghost" icon="ellipsis" on-press="toggle_thread_menu" label="Chat actions"></button>
          <if test="{thread_menu_open}">
            <dropdown-menu anchor="below" anchor-alignment="end" anchor-offset="6" width="180" height="100" padding="4" gap="2" on-dismiss="close_thread_menu" label="Chat actions">
              <menu-item size="sm" icon="edit" on-press="open_rename_thread">Rename chat</menu-item>
              <menu-item size="sm" icon="folder" on-press="open_move_thread">Move to project</menu-item>
              <separator />
              <menu-item size="sm" icon="archive" on-press="archive_thread">Archive chat</menu-item>
            </dropdown-menu>
          </if>
        </stack>
        <spacer width="{header_inset_right}" />
      </row>
      <separator />

      <scroll grow="1" value="{conversationScrollOffset}" on-scroll="conversation_scrolled" label="Conversation">
        <row main="center">
          <column width="680" padding="36" gap="36">
            <if test="{canLoadOlder}">
              <row main="center"><button size="sm" variant="ghost" on-press="load_older">Load earlier messages</button></row>
            </if>
            <if test="{hasMessages}">
              <for each="messageRows" key="id" as="m">
                <if test="{m.isUser}">
                  <row main="end">
                    <column cross="end" gap="4" label="User message group">
                      <bubble min-width="{m.userBubbleMinWidth}" padding="12" radius="xl" label="You said">
                        <column gap="8">
                          <text wrap="{m.userMessageWrap}">{m.content}</text>
                          <if test="{m.hasAttachments}">
                            <text size="sm" foreground="text_muted" wrap="true">{m.attachmentSummary}</text>
                          </if>
                        </column>
                      </bubble>
                      <row gap="0" main="end" cross="center" label="User message actions">
                        <button size="sm" variant="ghost" foreground="text_muted" icon="copy" on-press="copy_message:{m.id}" label="Copy message"></button>
                        <button size="sm" variant="ghost" foreground="text_muted" icon="edit" on-press="edit_message:{m.id}" label="Edit message"></button>
                      </row>
                    </column>
                  </row>
                </if>
                <else>
                  <column gap="12" label="Assistant said">
                    <if test="{m.responseMeta}">
                      <column gap="10">
                        <text size="sm" foreground="text_muted">Worked for {m.responseMeta}</text>
                        <separator />
                      </column>
                    </if>
                    <markdown source="{m.content}" />
                    <row gap="2" label="Response actions">
                      <button size="sm" variant="ghost" foreground="text_muted" icon="copy" on-press="copy_message:{m.id}" label="Copy response"></button>
                      <button size="sm" variant="ghost" foreground="text_muted" icon="refresh-cw" on-press="retry_message:{m.id}" label="Retry response"></button>
                      <button size="sm" variant="ghost" foreground="text_muted" icon="git-branch" on-press="open_fork:{m.id}" label="Fork from response"></button>
                    </row>
                  </column>
                </else>
              </for>
              <if test="{waitingForResponse}">
                <column gap="12" label="Assistant is working">
                  <column gap="10">
                    <text size="sm" foreground="text_muted">Working…</text>
                    <separator />
                  </column>
                  <row height="20" cross="center">
                    <spinner size="sm" />
                  </row>
                </column>
              </if>
            </if>
            <else>
              <column gap="8" padding="48" cross="center">
                <text size="heading" text-alignment="center">What are you working on?</text>
                <text foreground="text_muted" wrap="true" text-alignment="center">Start with one model. Branch the response when another perspective would help.</text>
              </column>
            </else>
          </column>
        </row>
      </scroll>

      <row main="center" background="background">
        <column width="680" padding="16" gap="8">
          <for each="draftAttachmentRows" key="index" as="a">
            <button size="sm" variant="outline" icon="x" on-press="remove_attachment:{a.index}" label="Remove {a.name}">{a.detail} · {a.name}</button>
          </for>
          <input-group key="{composerKey}" height="96" label="Message">
            <textarea text="{draft}" on-input="draft_edit" on-submit="composer_newline" autofocus="true" placeholder="Ask any model, or drop images and files…" label="Message" />
            <input-group-actions gap="8">
              <button size="sm" variant="ghost" icon="plus" on-press="open_file_picker" label="Attach images or files, Command U"></button>
              <select size="sm" width="190" on-press="toggle_model_picker" label="Model for the next response">{selectedModelLabel}</select>
              <spacer grow="1" />
              <if test="{sending}">
                <button size="sm" variant="outline" icon="x" on-press="stop">Stop</button>
              </if>
              <else>
                <button size="sm" variant="primary" icon="send" on-press="send" disabled="{cannotSend}" label="Send message"></button>
              </else>
            </input-group-actions>
          </input-group>
          <if test="{statusNeedsAttention}">
            <alert variant="outline" padding="10" label="Composer status">
              <text size="sm" foreground="text_muted" wrap="true">{statusLine}</text>
            </alert>
          </if>
        </column>
      </row>
    </column>
  </row>

  <if test="{model_picker_open}">
    <panel background="scrim" on-press="close_overlay" label="Palette backdrop">
      <column main="center" cross="center">
        <dialog width="760" height="500" label="Models and commands">
          <column padding="24" gap="12">
            <if test="{search_open}">
              <row gap="12" cross="center">
                <column gap="4" grow="1">
                  <text size="heading">Search workspace</text>
                  <text size="sm" foreground="text_muted">Find any conversation by title or message content.</text>
                </column>
                <button size="sm" variant="ghost" icon="x" on-press="close_overlay" label="Close search"></button>
              </row>
              <search-field text="{searchText}" on-input="search_edit" placeholder="Search every chat…" autofocus="true" />
              <scroll grow="1" label="Search results">
                <column gap="6">
                  <for each="searchRows" key="index" as="r">
                    <button variant="ghost" on-press="select_search_result:{r.index}">{r.title} · {r.snippet}</button>
                  </for>
                </column>
              </scroll>
            </if>
            <else>
            <if test="{move_open}">
              <row gap="12" cross="center">
                <column gap="4" grow="1">
                  <text size="heading">Move this chat</text>
                  <text size="sm" foreground="text_muted">Choose where this conversation should live.</text>
                </column>
                <button size="sm" variant="ghost" icon="x" on-press="close_overlay" label="Close"></button>
              </row>
              <scroll grow="1" label="Project destinations">
                <column padding="8" gap="4" background="surface_subtle" radius="lg">
                  <for each="moveProjectRows" as="p">
                    <list-item size="lg" icon="folder" on-press="move_thread_to:{p.id}" selected="{p.selected}">{p.name}</list-item>
                  </for>
                </column>
              </scroll>
            </if>
            <else>
            <if test="{model_selector_open}">
              <row gap="12" cross="center">
                <column gap="2" grow="1">
                  <text size="heading">Choose a model</text>
                  <text size="sm" foreground="text_muted">Currently using {selectedModelLabel}</text>
                </column>
                <button size="sm" variant="ghost" icon="x" on-press="close_overlay" label="Close model picker"></button>
              </row>
              <search-field text="{modelSearch}" on-input="model_search_edit" placeholder="Search models or providers…" autofocus="true" label="Model search" />
              <scroll grow="1" label="Models">
                <column gap="14" padding="4">
                  <if test="{paletteQuickModelsVisible}">
                    <column gap="8">
                      <if test="{modelSearchEmpty}">
                        <text size="sm" foreground="text_muted"><span weight="medium">Quick picks</span></text>
                      </if>
                      <else>
                        <text size="sm" foreground="text_muted"><span weight="medium">Quick matches</span></text>
                      </else>
                      <grid columns="3" gap="8">
                        <for each="paletteQuickModels" as="q">
                          <if test="{q.selected}">
                            <button size="lg" variant="secondary" selected="true" on-press="select_quick_model:{q.number}">{q.number} · {q.label}</button>
                          </if>
                          <else>
                            <button size="lg" variant="outline" on-press="select_quick_model:{q.number}">{q.number} · {q.label}</button>
                          </else>
                        </for>
                      </grid>
                    </column>
                  </if>
                  <if test="{modelSearchEmpty}">
                    <column gap="8">
                      <text size="sm" foreground="text_muted"><span weight="medium">Connections and custom models</span></text>
                      <grid columns="2" gap="8">
                        <if test="{autoModelSelected}">
                          <button size="lg" variant="secondary" selected="true" on-press="select_auto_model">OpenRouter Auto</button>
                        </if>
                        <else>
                          <button size="lg" variant="outline" on-press="select_auto_model">OpenRouter Auto</button>
                        </else>
                        <if test="{codexModelSelected}">
                          <button size="lg" variant="secondary" selected="true" on-press="select_codex_subscription">Codex · ChatGPT</button>
                        </if>
                        <else>
                          <button size="lg" variant="outline" on-press="select_codex_subscription">Codex · ChatGPT</button>
                        </else>
                        <button size="lg" variant="outline" on-press="select_custom_model">Enter a model ID…</button>
                      </grid>
                    </column>
                  </if>
                  <if test="{modelCatalogVisible}">
                    <column gap="6">
                      <row gap="8" cross="center">
                        <text size="sm" foreground="text_muted" grow="1"><span weight="medium">OpenRouter</span></text>
                        <text size="sm" foreground="text_muted">{modelCatalogStatus}</text>
                      </row>
                      <for each="catalogRows" key="index" as="m">
                        <row gap="4">
                          <list-item size="lg" gap="8" label="{m.label}" grow="1" on-press="select_catalog_model:{m.index}">
                            <icon name="circle-dot" foreground="text_muted" width="16" height="16" />
                            <text grow="1">{m.label}</text>
                            <text size="sm" foreground="text_muted">{m.slug}</text>
                          </list-item>
                          <button size="lg" variant="ghost" icon="{m.favorite_icon}" label="{m.favorite_label}" on-press="toggle_model_favorite:{m.index}"></button>
                        </row>
                      </for>
                    </column>
                  </if>
                </column>
              </scroll>
            </if>
            <else>
              <row gap="12" cross="center">
                <column gap="2" grow="1">
                  <text size="heading">Go anywhere</text>
                  <text size="sm" foreground="text_muted">Open recent work or run a command.</text>
                </column>
                <button size="sm" variant="ghost" icon="x" on-press="close_overlay" label="Close command palette"></button>
              </row>
              <search-field text="{modelSearch}" on-input="model_search_edit" placeholder="Search chats, projects, actions, or models…" autofocus="true" label="Command palette" />
              <scroll grow="1" label="Chats, projects, actions, and models">
                <column gap="14" padding="4">
                  <if test="{paletteActionsVisible}">
                    <column gap="6">
                      <if test="{modelSearchEmpty}">
                        <text size="sm" foreground="text_muted"><span weight="medium">Start here</span></text>
                      </if>
                      <else>
                        <text size="sm" foreground="text_muted"><span weight="medium">Commands</span></text>
                      </else>
                      <for each="paletteActionRows" as="a">
                        <list-item size="lg" gap="8" label="{a.label}" selected="{a.selected}" on-press="palette_action:{a.id}">
                          <icon name="{a.icon}" foreground="text_muted" width="16" height="16" />
                          <text grow="1">{a.label}</text>
                          <if test="{a.shortcut}">
                            <text size="sm" foreground="text_muted">{a.shortcut}</text>
                          </if>
                          <if test="{a.detail}">
                            <text size="sm" foreground="text_muted">{a.detail}</text>
                          </if>
                        </list-item>
                      </for>
                    </column>
                  </if>
                  <if test="{paletteWorkspaceVisible}">
                    <column gap="6">
                      <if test="{modelSearchEmpty}">
                        <text size="sm" foreground="text_muted"><span weight="medium">Recent work</span></text>
                      </if>
                      <else>
                        <text size="sm" foreground="text_muted"><span weight="medium">Workspace</span></text>
                      </else>
                      <for each="paletteWorkspaceRows" as="w">
                        <list-item size="lg" gap="8" label="{w.title}" selected="{w.selected}" on-press="select_palette_workspace:{w.key}">
                          <icon name="{w.icon}" foreground="text_muted" width="16" height="16" />
                          <text grow="1">{w.title}</text>
                          <text size="sm" foreground="text_muted">{w.detail}</text>
                        </list-item>
                      </for>
                    </column>
                  </if>
                  <if test="{modelSearchActive}">
                    <if test="{paletteQuickModelsVisible}">
                      <column gap="6">
                        <text size="sm" foreground="text_muted"><span weight="medium">Models</span></text>
                        <for each="paletteQuickModels" as="q">
                          <list-item size="lg" gap="8" label="{q.label}" selected="{q.selected}" on-press="select_quick_model:{q.number}">
                            <icon name="circle-dot" foreground="text_muted" width="16" height="16" />
                            <text grow="1">{q.label}</text>
                            <text size="sm" foreground="text_muted">{q.slug}</text>
                          </list-item>
                        </for>
                      </column>
                    </if>
                    <if test="{modelCatalogVisible}">
                      <column gap="4">
                        <row gap="8" cross="center">
                          <text size="sm" foreground="text_muted" grow="1"><span weight="medium">OpenRouter</span></text>
                          <text size="sm" foreground="text_muted">{modelCatalogStatus}</text>
                        </row>
                        <for each="catalogRows" key="index" as="m">
                          <row gap="4">
                            <list-item size="lg" gap="8" label="{m.label}" grow="1" on-press="select_catalog_model:{m.index}">
                              <icon name="circle-dot" foreground="text_muted" width="16" height="16" />
                              <text grow="1">{m.label}</text>
                              <text size="sm" foreground="text_muted">{m.slug}</text>
                            </list-item>
                            <button size="lg" variant="ghost" icon="{m.favorite_icon}" label="{m.favorite_label}" on-press="toggle_model_favorite:{m.index}"></button>
                          </row>
                        </for>
                      </column>
                    </if>
                  </if>
                </column>
              </scroll>
            </else>
            </else>
            </else>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{settings_open}">
    <panel background="scrim" on-press="close_settings" label="Settings backdrop">
      <column main="center" cross="center">
        <dialog width="780" height="640" label="Settings">
          <column padding="28" gap="16">
            <row gap="12" cross="center">
              <column gap="4" grow="1">
                <text size="heading">Settings</text>
                <text size="sm" foreground="text_muted">Connections, local tools, reusable prompts, and app preferences.</text>
              </column>
              <button size="sm" variant="ghost" icon="x" on-press="close_settings" label="Close settings"></button>
            </row>
            <scroll grow="1" label="Settings">
              <column gap="20">
                <column padding="16" gap="12" background="surface_subtle" radius="lg">
                  <column gap="4">
                    <text><span weight="bold">Model connections</span></text>
                    <text size="sm" foreground="text_muted" wrap="true">Connect a subscription or use OpenRouter for access to its full model catalog.</text>
                  </column>
                  <row gap="8">
                    <button grow="1" size="sm" variant="outline" on-press="connect_codex" disabled="{codexConnectionBusy}">{codexConnectionButtonText}</button>
                  </row>
                  <text-field text="{apiKeyField}" on-input="api_key_edit" on-submit="save_settings" placeholder="{apiKeyPlaceholder}" label="OpenRouter API key" />
                  <text-field text="{modelName}" on-input="model_edit" on-submit="save_settings" placeholder="provider/model" label="Custom OpenRouter model" />
                  <row gap="8" cross="center">
                    <checkbox checked="{notifications_enabled}" on-toggle="toggle_notifications" text="Notify when a background response finishes" />
                    <spacer grow="1" />
                    <button size="sm" variant="ghost" on-press="remove_api_key" disabled="{missingKey}">Remove key</button>
                  </row>
                </column>

                <column padding="16" gap="12" background="surface_subtle" radius="lg">
                  <column gap="4">
                    <text><span weight="bold">Local MCP integrations</span></text>
                    <text size="sm" foreground="text_muted" wrap="true">Servers run on this Mac. Tool calls are inserted into the composer for review before they run.</text>
                  </column>
                  <for each="mcpServerRows" as="s">
                    <row padding="8" gap="8" cross="center" background="surface" radius="md">
                      <column grow="1" gap="2">
                        <text><span weight="medium">{s.name}</span></text>
                        <text size="sm" foreground="text_muted">{s.detail}</text>
                      </column>
                      <button size="sm" variant="ghost" on-press="toggle_mcp_server:{s.id}" disabled="{mcpBusy}">{s.toggle_label}</button>
                      <button size="sm" variant="ghost" icon="refresh-cw" on-press="refresh_mcp_server:{s.id}" disabled="{mcpBusy}" label="Refresh {s.name}"></button>
                      <button size="sm" variant="ghost" icon="trash" on-press="remove_mcp_server:{s.id}" disabled="{mcpBusy}" label="Remove {s.name}"></button>
                    </row>
                  </for>
                  <row gap="8" cross="end">
                    <text-field size="sm" grow="1" text="{mcpServerName}" on-input="mcp_server_name_edit" placeholder="Filesystem" label="Server name" />
                    <text-field size="sm" grow="3" text="{mcpServerCommand}" on-input="mcp_server_command_edit" on-submit="add_mcp_server" placeholder="npx -y server /path" label="Local stdio command" />
                    <button size="sm" variant="outline" on-press="add_mcp_server" disabled="{cannotAddMcpServer}">Add server</button>
                  </row>
                  <for each="mcpToolRows" as="t">
                    <button size="sm" variant="ghost" icon="terminal" on-press="select_mcp_tool:{t.index}" disabled="{mcpBusy}">{t.title} · {t.detail}</button>
                  </for>
                </column>

                <column padding="16" gap="12" background="surface_subtle" radius="lg">
                  <column gap="4">
                    <text><span weight="bold">Prompt snippets</span></text>
                    <text size="sm" foreground="text_muted">Save repeatable instructions and insert them from the command palette.</text>
                  </column>
                  <for each="snippetRows" as="s">
                    <row gap="6">
                      <button size="sm" grow="1" variant="ghost" on-press="use_snippet:{s.id}">{s.command} · {s.preview}</button>
                      <button size="sm" variant="ghost" icon="trash" on-press="delete_snippet:{s.id}" label="Delete {s.command}"></button>
                    </row>
                  </for>
                  <row gap="8">
                    <text-field size="sm" grow="1" text="{snippetName}" on-input="snippet_name_edit" placeholder="name" label="Shortcut name" />
                    <text-field size="sm" grow="2" text="{snippetBody}" on-input="snippet_body_edit" on-submit="save_snippet" placeholder="Reusable prompt…" label="Prompt" />
                    <button size="sm" variant="outline" on-press="save_snippet" disabled="{cannotSaveSnippet}">Save</button>
                  </row>
                </column>

                <column padding="16" gap="8" background="surface_subtle" radius="lg">
                  <text><span weight="bold">Updates</span></text>
                  <button size="sm" variant="outline" icon="refresh-cw" on-press="open_update" disabled="{updateButtonDisabled}">{updateStatus} · {updateButtonText}</button>
                </column>

                <column padding="16" gap="10" background="surface_subtle" radius="lg">
                  <column gap="4">
                    <text><span weight="bold">About Superchat</span></text>
                    <text size="sm" foreground="text_muted">{versionLabel} · GNU AGPL v3 only</text>
                    <text size="sm" foreground="text_muted" wrap="true">Copyright © 2026 Stuart Sim. This software is provided without warranty.</text>
                    <text size="sm" foreground="text_muted" wrap="true">Third-party components retain their original licences. Superchat is not affiliated with model providers.</text>
                  </column>
                  <row gap="8">
                    <button size="sm" variant="outline" icon="external-link" on-press="open_source">Source code</button>
                    <button size="sm" variant="outline" icon="file-text" on-press="open_license">Licence</button>
                    <button size="sm" variant="outline" icon="external-link" on-press="open_privacy">Privacy</button>
                    <button size="sm" variant="outline" icon="download" on-press="export_diagnostics">Export diagnostics</button>
                  </row>
                </column>
              </column>
            </scroll>
            <row gap="8" main="end">
              <text size="sm" foreground="text_muted" grow="1">Changes apply locally to this Mac.</text>
              <button size="sm" variant="primary" on-press="save_settings" disabled="{cannotSaveSettings}">Save changes</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{project_context_open}">
    <panel background="scrim" on-press="close_project_context" label="Project context backdrop">
      <column main="center" cross="center">
        <dialog width="680" height="540" label="Project instructions and knowledge">
          <column padding="28" gap="16">
            <row gap="12" cross="center">
              <column grow="1" gap="4">
                <text size="heading">Project context</text>
                <text size="sm" foreground="text_muted">Shared with every chat in this project.</text>
              </column>
              <button size="sm" variant="ghost" icon="x" on-press="close_project_context" label="Close project context"></button>
            </row>
            <column gap="8">
              <text><span weight="bold">Instructions</span></text>
              <textarea text="{projectInstructions}" on-input="project_instructions_edit" height="180" placeholder="Describe the project, preferred style, constraints, and goals…" label="Project instructions" />
            </column>
            <column padding="14" gap="10" background="surface_subtle" radius="lg">
              <row gap="8" cross="center">
                <column grow="1" gap="3">
                  <text><span weight="bold">Shared knowledge files</span></text>
                  <text size="sm" foreground="text_muted" wrap="true">UTF-8 text and code files are copied into this project's local knowledge context.</text>
                </column>
                <button size="sm" variant="outline" icon="plus" on-press="open_project_file_picker">Add files</button>
                <if test="{projectHasKnowledge}"><button size="sm" variant="ghost" on-press="clear_project_files">Clear</button></if>
              </row>
              <text size="sm" foreground="text_muted" wrap="true">{projectKnowledgeFiles}</text>
            </column>
            <spacer grow="1" />
            <row main="end" gap="8">
              <button size="sm" variant="ghost" on-press="close_project_context">Cancel</button>
              <button size="sm" variant="primary" on-press="save_project_context">Save project context</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{shortcuts_open}">
    <panel background="scrim" on-press="close_shortcuts" label="Keyboard shortcuts backdrop">
      <column main="center" cross="center">
        <dialog width="680" height="520" label="Keyboard shortcuts">
          <column padding="24" gap="14">
            <row gap="12" cross="center">
              <column grow="1" gap="4">
                <row gap="8" cross="center">
                  <text size="heading">Keyboard shortcuts</text>
                  <row gap="4" cross="center">
                    <badge size="sm" variant="secondary">Cmd</badge>
                    <badge size="sm" variant="secondary">,</badge>
                  </row>
                </row>
                <text size="sm" foreground="text_muted">Move through Superchat without leaving the keyboard.</text>
              </column>
              <button size="sm" variant="ghost" icon="x" on-press="close_shortcuts" label="Close keyboard shortcuts"></button>
            </row>
            <search-field size="sm" text="{shortcutSearch}" on-input="shortcut_search_edit" placeholder="Search shortcuts…" autofocus="true" label="Search keyboard shortcuts" />
            <scroll grow="1" label="Keyboard shortcuts list. Use Arrow keys, Page Up, Page Down, Home, or End to scroll.">
              <column padding="8" gap="2" background="surface_subtle" radius="lg">
                <for each="shortcutRows" as="h">
                  <row padding="8" gap="16" cross="center">
                    <text grow="1">{h.action}</text>
                    <badge size="sm" variant="secondary">{h.keys}</badge>
                  </row>
                </for>
                <if test="{shortcutSearchEmpty}">
                  <column padding="24" gap="4" cross="center">
                    <text><span weight="bold">No shortcuts found</span></text>
                    <text size="sm" foreground="text_muted">Try an action or key combination.</text>
                  </column>
                </if>
              </column>
            </scroll>
            <row gap="12" cross="center">
              <text size="sm" foreground="text_muted" grow="1">Tab to the list · ↑ ↓ or Page Up / Page Down to scroll</text>
              <button size="sm" variant="primary" on-press="close_shortcuts">Done</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{fork_open}">
    <panel background="scrim" on-press="close_fork" label="Fork conversation backdrop">
    <row main="end" cross="center" padding="24">
    <sheet width="520" height="680" label="Compare with other models">
      <column padding="28" gap="18">
        <row gap="12" cross="center">
          <column gap="4" grow="1">
            <text size="heading">Compare with other models</text>
            <text size="sm" foreground="text_muted">Continue this conversation in parallel.</text>
          </column>
          <button size="sm" variant="ghost" icon="x" on-press="close_fork" label="Close branching panel"></button>
        </row>

        <column padding="14" gap="6" background="surface_subtle" radius="lg">
          <row gap="8" cross="center">
            <icon name="git-branch" width="18" height="18" foreground="accent" />
            <text grow="1"><span weight="bold">{activeThreadTitle}</span></text>
            <badge size="sm" variant="secondary">Source</badge>
          </row>
          <text size="sm" foreground="text_muted" wrap="true">Each branch starts after this response and continues independently.</text>
        </column>

        <column gap="8">
          <text size="sm" foreground="text_muted"><span weight="medium">Shared follow-up</span></text>
          <textarea text="{forkSeed}" on-input="fork_seed_edit" on-submit="create_forks" height="108" placeholder="Give every selected model the same next instruction…" label="Branch follow-up message" />
        </column>

        <column gap="8" grow="1">
          <text size="sm" foreground="text_muted"><span weight="medium">Choose models</span></text>
          <scroll grow="1" label="Models available for branching">
            <column padding="10" gap="4" background="surface_subtle" radius="lg">
              <for each="forkModelRows" as="m">
                <row padding="8" gap="10" cross="center">
                  <checkbox checked="{m.selected}" on-toggle="toggle_fork_model:{m.choice}" text="{m.label}" label="{m.label}" />
                </row>
              </for>
            </column>
          </scroll>
        </column>

        <row gap="8">
          <button grow="1" variant="ghost" on-press="close_fork">Cancel</button>
          <button grow="2" variant="primary" icon="git-branch" on-press="create_forks" disabled="{cannotCreateForks}">{forkCountLabel}</button>
        </row>
      </column>
    </sheet>
    </row>
    </panel>
  </if>

  <if test="{rename_open}">
    <panel background="scrim" on-press="close_rename" label="Rename backdrop">
      <column main="center" cross="center">
        <dialog width="500" height="244" label="Rename">
          <column padding="28" gap="14">
            <row gap="12" cross="center">
              <column gap="4" grow="1">
                <text size="heading">{renameHeading}</text>
                <text size="sm" foreground="text_muted">The new name updates everywhere immediately.</text>
              </column>
              <button size="sm" variant="ghost" icon="x" on-press="close_rename" label="Close rename dialog"></button>
            </row>
            <text-field text="{renameValue}" on-input="rename_edit" on-submit="save_rename" autofocus="true" label="New name" />
            <spacer grow="1" />
            <row gap="8" main="end">
              <button size="sm" variant="ghost" on-press="close_rename">Cancel</button>
              <button size="sm" variant="primary" on-press="save_rename" disabled="{cannotSaveRename}">Rename</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{archive_open}">
    <panel background="scrim" on-press="close_archive" label="Archive backdrop">
      <column main="center" cross="center">
        <dialog width="760" height="560" label="Archive">
          <column padding="28" gap="16">
            <row gap="12" cross="center">
              <column gap="4" grow="1">
                <text size="heading">Archive</text>
                <text size="sm" foreground="text_muted">Archived items are removed automatically after 30 days.</text>
              </column>
              <button size="sm" variant="ghost" icon="x" on-press="close_archive" label="Close archive"></button>
            </row>
            <scroll grow="1" label="Archived items">
              <column gap="8">
                <if test="{archiveEmpty}">
                  <column padding="48" gap="10" cross="center" background="surface_subtle" radius="lg">
                    <icon name="archive" width="28" height="28" foreground="text_muted" />
                    <text><span weight="bold">Nothing archived</span></text>
                    <text size="sm" foreground="text_muted">Chats and projects you archive will appear here.</text>
                  </column>
                </if>
                <for each="archivedProjectRows" as="p">
                  <row padding="12" gap="8" cross="center" background="surface_subtle" radius="md">
                    <icon name="folder" width="18" height="18" foreground="text_muted" />
                    <column gap="2" grow="1">
                      <text><span weight="medium">{p.name}</span></text>
                      <text size="sm" foreground="text_muted">Project · {p.expiry}</text>
                    </column>
                    <button size="sm" variant="outline" on-press="restore_project:{p.id}">Restore</button>
                    <button size="sm" variant="ghost" icon="trash" on-press="delete_project:{p.id}" label="Delete project forever"></button>
                  </row>
                </for>
                <for each="archivedThreadRows" as="t">
                  <row padding="12" gap="8" cross="center" background="surface_subtle" radius="md">
                    <icon name="archive" width="18" height="18" foreground="text_muted" />
                    <column gap="2" grow="1">
                      <text><span weight="medium">{t.title}</span></text>
                      <text size="sm" foreground="text_muted">{t.project_name} · {t.expiry}</text>
                    </column>
                    <button size="sm" variant="outline" on-press="restore_thread:{t.id}">Restore</button>
                    <button size="sm" variant="ghost" icon="trash" on-press="delete_thread:{t.id}" label="Delete chat forever"></button>
                  </row>
                </for>
              </column>
            </scroll>
            <if test="{delete_confirm_open}">
              <row padding="12" gap="8" cross="center" background="surface_subtle" radius="md">
                <icon name="info" width="18" height="18" foreground="destructive" />
                <text grow="1" wrap="true">Permanently delete {deleteTargetLabel}? This cannot be undone.</text>
                <button size="sm" variant="ghost" on-press="cancel_delete">Cancel</button>
                <button size="sm" variant="destructive" on-press="confirm_delete">Delete forever</button>
              </row>
            </if>
            <row main="end"><button size="sm" variant="primary" on-press="close_archive">Done</button></row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{onboarding_open}">
    <panel background="scrim" label="Welcome to Superchat">
      <column main="center" cross="center">
        <dialog width="720" height="520" label="Connect a model provider">
          <column padding="32" gap="18">
            <column gap="6">
              <text size="heading">Choose how Superchat responds</text>
              <text foreground="text_muted" wrap="true">Connect an existing subscription or use OpenRouter. Credentials stay in your Mac Keychain.</text>
            </column>

            <grid columns="1" gap="12">
              <card padding="16" background="surface_subtle">
                <column gap="10">
                  <row><avatar size="sm">C</avatar></row>
                  <text><span weight="bold">Codex</span></text>
                  <text size="sm" foreground="text_muted" wrap="true">Use the models included with your ChatGPT account.</text>
                  <spacer grow="1" />
                  <button size="sm" variant="outline" on-press="connect_codex" disabled="{codexConnectionBusy}">{codexConnectionButtonText}</button>
                </column>
              </card>
            </grid>

            <card padding="16" background="surface_subtle">
              <column gap="10">
                <row gap="8" cross="center">
                  <avatar size="sm">O</avatar>
                  <column gap="2" grow="1">
                    <text><span weight="bold">OpenRouter API key</span></text>
                    <text size="sm" foreground="text_muted">One key for the broader model catalog.</text>
                  </column>
                </row>
                <row gap="8" cross="end">
                  <text-field grow="1" text="{apiKeyField}" on-input="api_key_edit" on-submit="finish_onboarding" placeholder="sk-or-v1-…" autofocus="true" label="API key" />
                  <button variant="primary" on-press="finish_onboarding" disabled="{cannotFinishOnboarding}">Connect</button>
                </row>
              </column>
            </card>

            <if test="{statusVisible}">
              <text size="sm" foreground="text_muted" wrap="true">{statusLine}</text>
            </if>
            <row gap="8" cross="center">
              <text size="sm" foreground="text_muted" grow="1">You can add or change providers later in Settings.</text>
              <button size="sm" variant="ghost" on-press="skip_onboarding">Set up later</button>
            </row>
          </column>
        </dialog>
      </column>
    </panel>
  </if>

  <if test="{toastVisible}">
    <column main="end" cross="end" padding="24">
      <panel min-width="260" background="surface" border-color="accent" radius="lg" label="Notification">
        <row padding="14" gap="10" cross="center">
          <icon name="check" width="22" height="22" foreground="accent" />
          <text>{toastText}</text>
        </row>
      </panel>
    </column>
  </if>
</stack>
