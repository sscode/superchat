.{
    .id = "dev.sscode.superchat",
    .name = "superchat",
    .display_name = "Superchat",
    .description = "A minimal, model-agnostic OpenRouter chat client.",
    .version = "0.1.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{"macos"},
    .permissions = .{ "command", "view", "network", "credentials", "clipboard" },
    .capabilities = .{ "native_views", "gpu_surfaces", "shortcuts" },
    .shortcuts = .{
        .{ .id = "workspace.new-thread", .key = "n", .modifiers = .{"primary"} },
        .{ .id = "workspace.new-project-thread", .key = "n", .modifiers = .{ "primary", "option" } },
        .{ .id = "workspace.new-project", .key = "n", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.previous-thread", .key = "[", .modifiers = .{"primary"} },
        .{ .id = "workspace.next-thread", .key = "]", .modifiers = .{"primary"} },
        .{ .id = "workspace.previous-project", .key = "arrowup", .modifiers = .{ "primary", "option" } },
        .{ .id = "workspace.next-project", .key = "arrowdown", .modifiers = .{ "primary", "option" } },
        .{ .id = "workspace.focus-composer", .key = "l", .modifiers = .{"primary"} },
        .{ .id = "workspace.model-picker", .key = "k", .modifiers = .{"primary"} },
        .{ .id = "workspace.top-level-chats", .key = "0", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-1", .key = "1", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-2", .key = "2", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-3", .key = "3", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-4", .key = "4", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-5", .key = "5", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-6", .key = "6", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-7", .key = "7", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-8", .key = "8", .modifiers = .{"primary"} },
        .{ .id = "workspace.project-9", .key = "9", .modifiers = .{"primary"} },
        .{ .id = "workspace.thread-1", .key = "1", .modifiers = .{"option"} },
        .{ .id = "workspace.thread-2", .key = "2", .modifiers = .{"option"} },
        .{ .id = "workspace.thread-3", .key = "3", .modifiers = .{"option"} },
        .{ .id = "workspace.thread-4", .key = "4", .modifiers = .{"option"} },
        .{ .id = "workspace.thread-5", .key = "5", .modifiers = .{"option"} },
        .{ .id = "workspace.thread-6", .key = "6", .modifiers = .{"option"} },
        .{ .id = "workspace.thread-7", .key = "7", .modifiers = .{"option"} },
        .{ .id = "workspace.thread-8", .key = "8", .modifiers = .{"option"} },
        .{ .id = "workspace.thread-9", .key = "9", .modifiers = .{"option"} },
        .{ .id = "workspace.model-auto", .key = "0", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-1", .key = "1", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-2", .key = "2", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-3", .key = "3", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-4", .key = "4", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-5", .key = "5", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-6", .key = "6", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-7", .key = "7", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-8", .key = "8", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.model-9", .key = "9", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.settings", .key = ",", .modifiers = .{"primary"} },
        .{ .id = "workspace.fork-latest", .key = "f", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.copy-latest", .key = "c", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.rename-thread", .key = "r", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.rename-project", .key = "r", .modifiers = .{ "primary", "option" } },
        .{ .id = "workspace.archive-thread", .key = "e", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.archive-project", .key = "e", .modifiers = .{ "primary", "option" } },
        .{ .id = "workspace.archive", .key = "h", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.clear-thread", .key = "backspace", .modifiers = .{ "primary", "shift" } },
        .{ .id = "workspace.load-older", .key = "l", .modifiers = .{ "primary", "option" } },
        .{ .id = "workspace.close-overlay", .key = "escape" },
    },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Superchat",
                .width = 940,
                .height = 680,
                .min_width = 720,
                .min_height = 480,
                .restore_state = true,
                .restore_policy = "center_on_primary",
                .titlebar = "standard",
                .views = .{
                    .{ .label = "chat-canvas", .kind = "gpu_surface", .fill = true, .role = "Chat canvas", .accessibility_label = "Superchat", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
}
